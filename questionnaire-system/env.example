# ============================================
# 🎯 智能问卷作答系统 - 环境配置示例
# ============================================

# 🌐 小社会系统API配置
# 小社会系统提供智能数字人档案服务
XIAOSHE_API_URL=http://localhost:5001

# 🔑 青果代理配置
# 青果隧道代理配置，用于网络代理访问
QINGUO_BUSINESS_ID=YOUR_BUSINESS_ID
QINGUO_AUTH_KEY=YOUR_AUTH_KEY
QINGUO_AUTH_PWD=YOUR_AUTH_PASSWORD
QINGUO_TUNNEL_HOST=tun-szbhry.qg.net
QINGUO_TUNNEL_PORT=17790

# 🖥️ AdsPower浏览器管理配置 - 支持多种部署场景
# AdsPower API配置，系统会自动检测可用接口
ADSPOWER_API_URL=http://127.0.0.1:50325/api/v1
ADSPOWER_API_KEY=YOUR_ADSPOWER_SERIAL_NUMBER_HERE

# 其他可能的配置（根据环境选择）:
# 本地环境（旧版AdsPower）: http://local.adspower.net:50325/api/v1  
# 远程AdsPower服务器: http://192.168.1.100:50325/api/v1
# 容器化部署: http://adspower-container:50325/api/v1
# 云服务器部署: http://adspower.example.com:50325/api/v1

# 🤖 OpenAI配置
# 用于智能作答的AI模型配置
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o

# 🔮 Gemini配置（备选AI模型）
# Google Gemini API配置
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# 🌐 Web服务器配置
# 系统Web界面端口配置
WEB_PORT=5004

# 📋 系统配置
# 默认数字人档案ID，如果不指定则使用智能匹配
DEFAULT_DIGITAL_PERSON_ID=student_tech

# 🎯 作答配置
# 智能作答相关配置
MAX_RETRY_ATTEMPTS=3
ANSWER_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=60000

# 🔧 调试配置
# 开发和调试相关配置
DEBUG_MODE=false
LOG_LEVEL=info
ENABLE_MEMORY_CACHE=true
ENABLE_PROXY_CACHE=true